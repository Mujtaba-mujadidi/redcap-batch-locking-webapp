{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the REDCap Batch Locking desktop shell.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:3847",
      "http://127.0.0.1:3847/*",
      "http://localhost:3847",
      "http://localhost:3847/*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-home-write-recursive",
    "fs:allow-document-write-recursive",
    "fs:allow-download-write-recursive",
    "fs:allow-desktop-write-recursive",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "redcap-api",
          "sidecar": true
        }
      ]
    }
  ]
}
